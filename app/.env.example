# No secrets are needed for SecretGate.
# Forge apps use the Atlassian account login (forge login / API token) and
# Forge storage — there is no .env with credentials for this app.
# This file exists only so the rulebook's ".env.example" convention is honoured.
# NEVER put an Atlassian API token, Forge credentials or any secret here.
FORGE_EMAIL=
FORGE_API_TOKEN=
